# Копируется в /etc/livequiz.env, права 600, владелец root.
#
#   sudo install -m 600 -o root -g root livequiz.env.example /etc/livequiz.env
#   sudo nano /etc/livequiz.env
#
# Этот файл — единственное место с секретом, поэтому в git его нет.

# Порт, который слушает Node. Наружу он не смотрит: перед ним nginx.
PORT=8787

# ОБЯЗАТЕЛЬНО СМЕНИТЬ. Один PIN закрывает кабинет, пульт и загрузку файлов —
# на публичном адресе значение по умолчанию подбирается мгновенно.
HOST_PIN=

# Код первой игры. Можно не задавать — тогда сгенерируется случайный.
# Задавать имеет смысл, когда карточки с QR на столы уже напечатаны.
# GAME_CODE=481203

# Где лежит снимок игр. Менять нужно, только если на одной машине идёт
# репетиция рядом с настоящим вечером: два процесса с общим файлом
# восстанавливают друг друга и молча теряют счёт.
# STATE_FILE=/opt/livequiz/var/games-8787.json
